# 자격증명 템플릿 — 값은 비워둔다. 이 파일만 커밋된다.
# 실제 값은 ~/.config/edgeqgate/env (권장) 또는 이 리포의 .env.local 에 둔다.
# 둘 다 gitignore 되어 있고, 전자는 리포 바깥이라 git add -A 사고에도 안전하다.

# --- Nebius ---
# Token Factory (OpenAI 호환 추론 엔드포인트, D3/D4 Nemotron 호출용)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=

# Serverless Jobs / Endpoint (§5.3 팬아웃, D6 폴백)
# 콘솔에서 확인되는 실제 이름과 다르면 알려주세요. 이 이름들은 제안값입니다.
NEBIUS_PROJECT_ID=
NEBIUS_TENANT_ID=
NEBIUS_SERVICE_ACCOUNT_KEY_FILE=
NEBIUS_REGION=

# --- Tavily (D5, 그리고 score_folklore 채택 시) ---
TAVILY_API_KEY=

# --- Hugging Face (공개 SO-101 데이터셋, GR00T 게이트 접근) ---
HF_TOKEN=
